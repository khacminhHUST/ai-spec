MEP_NS=
# Provider dùng bản mock (phân cách phẩy): deepinfra, google, all. Thiếu key → tự mock.
MEP_MOCK=
# Thư mục gốc chứa bộ tài liệu mẫu (source_root trong projects.yaml tính từ đây)
MEP_DATA_ROOT=D:/ai-spec
