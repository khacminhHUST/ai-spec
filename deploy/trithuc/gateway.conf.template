# Gateway server 2 – cửa vào duy nhất của app MEP.
# nginx_proxy (server 1) chuyển NGUYÊN đường dẫn ${PUBLIC_PREFIX}/… sang đây (đã kiểm đăng nhập bằng auth_request).
# Biến thay khi khởi động: PUBLIC_PREFIX (vd /thongtinduan), ALLOW_FROM (IP server 1, vd 10.34.91.6).

server {
    listen 8090;
    server_tokens off;
    absolute_redirect off;    # redirect tương đối: không lộ http://…:8090 ra trình duyệt

    # Chỉ server 1 được gọi vào: backend tin token đã được server 1 kiểm (app/api/trusted_proxy.py).
    allow ${ALLOW_FROM};
    allow 127.0.0.1;
    deny all;

    client_max_body_size 1024m;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;

    location = /healthz {
        proxy_pass http://api:8000/healthz;
    }

    location = ${PUBLIC_PREFIX} {
        return 301 ${PUBLIC_PREFIX}/;
    }

    # API: bỏ tiền tố "${PUBLIC_PREFIX}/api" → backend nhận /chat, /knowledge…
    location ^~ ${PUBLIC_PREFIX}/api/ {
        proxy_pass http://api:8000/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $http_x_real_ip;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_buffering off;      # chat trả về dạng SSE
        proxy_cache off;
        # Cookie gắn trình duyệt với callback OAuth MCP: backend đặt Path=/mcp/oauth → đổi theo đường dẫn công khai
        proxy_cookie_path /mcp/oauth ${PUBLIC_PREFIX}/api/mcp/oauth;
    }

    # Frontend (file tĩnh). Chỉ cho nhúng iframe từ chính tên miền (trang Tri thức).
    root /usr/share/nginx/html;

    location ^~ ${PUBLIC_PREFIX}/assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location ^~ ${PUBLIC_PREFIX}/ {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "frame-ancestors 'self'";
        add_header X-Content-Type-Options "nosniff";
        try_files $uri $uri/ ${PUBLIC_PREFIX}/index.html;
    }

    location / {
        return 404;
    }
}
