# Cấu hình server 2 – chép thành .env (KHÔNG commit .env).

# ---- Nhúng vào web Tri thức
PUBLIC_ORIGIN=https://trithuc.hawee.com.vn
PUBLIC_PREFIX=/thongtinduan
# IP server 1 (nginx_proxy) – chỉ IP này được gọi vào gateway
ALLOW_FROM=10.34.91.6
GATEWAY_PORT=8090
# Tên khóa token web Tri thức lưu trong sessionStorage/localStorage (STORAGE_KEY_TOKEN trong
# ai_trithuc_frontend/services/userService.ts)
AUTH_TOKEN_KEY=
# Trường email trong payload JWT (để trống: thử "email" rồi "sub")
AUTH_USER_CLAIM=

# ---- Dữ liệu
POSTGRES_PASSWORD=
MEP_NS=ingest

# ---- Khóa API (như .env khi chạy local)
GOOGLE_API_KEY=
DEEPINFRA_API_KEY=
# Mã hóa token OAuth của nguồn MCP (giữ cố định; đổi là mất các kết nối đã lưu)
MEP_SECRET_KEY=

# ---- Mạng ra ngoài qua proxy công ty (nếu có)
# HTTPS_PROXY=http://proxy.hawee.local:3128
# NO_PROXY=postgres,qdrant,api,localhost,127.0.0.1
